{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operator-registry",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "operator-registry",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }]
}
